# Resend API key from https://resend.com/api-keys
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Inbox that receives new quote lead notifications
LEAD_TO_EMAIL=you@example.com

# Optional. Must be a verified domain sender in Resend.
# For local testing you can use Resend's onboarding address:
# RESEND_FROM_EMAIL=onboarding@resend.dev
RESEND_FROM_EMAIL=quotes@your-verified-domain.com
